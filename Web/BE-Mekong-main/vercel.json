{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nestjs",
  "installCommand": "npm ci --include=dev",
  "outputDirectory": null,
  "functions": {
    "src/main.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  }
}
